{
   "name": "usehop",
   "version": "0.1.0",
   "license": "MIT",
   "description": "Website to showcase the Hop browser extension",
   "author": "Mason McElvain",
   "repository": {
      "type": "git",
      "url": "https://github.com/masonmcelvain/usehop"
   },
   "packageManager": "pnpm@12.4.1",
   "engines": {
      "node": "24.21.0"
   },
   "scripts": {
      "dev": "next dev",
      "build": "next build",
      "start": "next start",
      "format": "prettier --write .",
      "lint": "eslint .",
      "prepare": "husky",
      "type-check": "tsc --pretty"
   },
   "dependencies": {
      "next": "16.3.5",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-icons": "5.7.0"
   },
   "devDependencies": {
      "@eslint/eslintrc": "3.3.7",
      "@eslint/js": "10.0.1",
      "@tailwindcss/postcss": "4.3.3",
      "@types/node": "24.13.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@typescript-eslint/eslint-plugin": "8.70.0",
      "@typescript-eslint/parser": "8.70.0",
      "eslint": "10.11.0",
      "eslint-config-next": "16.3.5",
      "eslint-config-prettier": "10.1.8",
      "husky": "9.1.7",
      "lint-staged": "17.5.1",
      "postcss": "8.5.28",
      "prettier": "3.9.6",
      "prettier-plugin-tailwindcss": "0.8.1",
      "tailwindcss": "4.3.3",
      "typescript": "6.0.3"
   },
   "lint-staged": {
      "*": "prettier --write --ignore-unknown"
   }
}
